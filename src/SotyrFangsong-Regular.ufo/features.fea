#
# Feature definitions
#

feature ccmp { # Glyph Composition / Decomposition
    sub f f b by f_f_b.ccmp;
    sub f f f by f_f_f.ccmp;
    sub f f h by f_f_h.ccmp;
    sub f f i by f_f_i.ccmp;
    sub f f j by f_f_j.ccmp;
    sub f f k by f_f_k.ccmp;
    sub f f l by f_f_l.ccmp;
    sub f f t by f_f_t.ccmp;
    sub f f u by f_f_u.ccmp;
    sub f b by f_b.ccmp;
    sub f f by f_f.ccmp;
    sub f h by f_h.ccmp;
    sub f i by f_i.ccmp;
    sub f j by f_j.ccmp;
    sub f k by f_k.ccmp;
    sub f l by f_l.ccmp;
    sub f t by f_t.ccmp;
    sub f u by f_u.ccmp;
    sub g g by g_g.ccmp;
    sub i j by i_j.ccmp;
    sub t t by t_t.ccmp;
    sub emdash emdash by twoemdash;
} ccmp;

feature ss01 { # Stylistic Set 1
    featureNames {
        name "ss01"; # English - United States
        name 3 1 0x0804 "半身標點"; # Chinese - People's Republic of China
    };
    sub ideographicfullstop by halfwidthideographicfullstop;
    sub katakanamiddledot by katakanamiddledot.ss01;
    sub ideographiccomma by halfwidthideographiccomma;
    sub fullwidthcomma by fullwidthcomma.ss01;
    sub fullwidthcolon by fullwidthcolon.ss01;
    sub fullwidthsemicolon by fullwidthsemicolon.ss01;
    sub fullwidthexclamationmark by fullwidthexclamationmark.ss01;
    sub fullwidthquestionmark by fullwidthquestionmark.ss01;
    sub leftanglebracket by leftanglebracket.ss01;
    sub rightanglebracket by rightanglebracket.ss01;
    sub leftdoubleanglebracket by leftdoubleanglebracket.ss01;
    sub rightdoubleanglebracket by rightdoubleanglebracket.ss01;
    sub leftcornerbracket by halfwidthleftcornerbracket;
    sub rightcornerbracket by halfwidthrightcornerbracket;
    sub leftwhitecornerbracket by leftwhitecornerbracket.ss01;
    sub rightwhitecornerbracket by rightwhitecornerbracket.ss01;
    sub leftblacklenticularbracket by leftblacklenticularbracket.ss01;
    sub rightblacklenticularbracket by rightblacklenticularbracket.ss01;
    sub leftwhitelenticularbracket by leftwhitelenticularbracket.ss01;
    sub rightwhitelenticularbracket by rightwhitelenticularbracket.ss01;
    sub lefttortoiseshellbracket by lefttortoiseshellbracket.ss01;
    sub righttortoiseshellbracket by righttortoiseshellbracket.ss01;
    sub fullwidthparenleft by fullwidthparenleft.ss01;
    sub fullwidthparenright by fullwidthparenright.ss01;
    sub fullwidthsolidus by fullwidthsolidus.ss01;
    sub fullwidthreversesolidus by fullwidthreversesolidus.ss01;
    sub fullwidthverticalline by fullwidthverticalline.ss01;
    sub emspace by enspace;
    sub quoteleft by quoteleft.ss01;
    sub quoteright by quoteright.ss01;
    sub quotedblleft by quotedblleft.ss01;
    sub quotedblright by quotedblright.ss01;
    sub bullet by bullet.ss01;
    sub whitebullet by whitebullet.ss01;
} ss01;

feature vrt2 { # Vertical Alternates and Rotation
    lookup SingleSubstitution2;
} vrt2;

feature vert { # Vertical Writing
    lookup SingleSubstitution2;
} vert;

feature ss02 { # Stylistic Set 2
    featureNames {
        name "ss02"; # English - United States
        name 3 1 0x0804 "縱排標點在當字右側中央"; # Chinese - People's Republic of China
    };
    sub presentationformforverticalideographicfullstop by presentationformforverticalideographicfullstop.ss02;
    sub katakanamiddledot.vert by katakanamiddledot.vert.1;
    sub presentationformforverticalideographiccomma by presentationformforverticalideographiccomma.ss02;
    sub presentationformforverticalcomma by presentationformforverticalcomma.ss02;
    sub presentationformforverticalcolon by presentationformforverticalcolon.ss02;
    sub presentationformforverticalsemicolon by presentationformforverticalsemicolon.ss02;
    sub presentationformforverticalexclamationmark by presentationformforverticalexclamationmark.ss02;
    sub presentationformforverticalquestionmark by presentationformforverticalquestionmark.ss02;
    sub halfwidthideographicfullstop.vert by presentationformforverticalideographicfullstop.ss02;
    sub katakanamiddledot.ss01.1 by katakanamiddledot.vert.1;
    sub halfwidthideographiccomma.vert by presentationformforverticalideographiccomma.ss02;
    sub fullwidthcomma.ss01.1 by presentationformforverticalcomma.ss02;
    sub fullwidthcolon.ss01.1 by presentationformforverticalcolon.ss02;
    sub fullwidthsemicolon.ss01.1 by presentationformforverticalsemicolon.ss02;
    sub fullwidthexclamationmark.ss01.1 by presentationformforverticalexclamationmark.ss02;
    sub fullwidthquestionmark.ss01.1 by presentationformforverticalquestionmark.ss02;
} ss02;

feature ss03 { # Stylistic Set 3
    featureNames {
        name "ss03"; # English - United States
        name 3 1 0x0804 "縱排標點在當字右側底部"; # Chinese - People's Republic of China
    };
    sub presentationformforverticalideographicfullstop by presentationformforverticalideographicfullstop.ss03;
    sub katakanamiddledot.vert by katakanamiddledot.vert.2;
    sub presentationformforverticalideographiccomma by presentationformforverticalideographiccomma.ss03;
    sub presentationformforverticalcomma by presentationformforverticalcomma.ss03;
    sub presentationformforverticalcolon by presentationformforverticalcolon.ss03;
    sub presentationformforverticalsemicolon by presentationformforverticalsemicolon.ss03;
    sub presentationformforverticalexclamationmark by presentationformforverticalexclamationmark.ss03;
    sub presentationformforverticalquestionmark by presentationformforverticalquestionmark.ss03;
    sub halfwidthideographicfullstop.vert by presentationformforverticalideographicfullstop.ss03;
    sub katakanamiddledot.ss01.1 by katakanamiddledot.vert.2;
    sub halfwidthideographiccomma.vert by presentationformforverticalideographiccomma.ss03;
    sub fullwidthcomma.ss01.1 by presentationformforverticalcomma.ss03;
    sub fullwidthcolon.ss01.1 by presentationformforverticalcolon.ss03;
    sub fullwidthsemicolon.ss01.1 by presentationformforverticalsemicolon.ss03;
    sub fullwidthexclamationmark.ss01.1 by presentationformforverticalexclamationmark.ss03;
    sub fullwidthquestionmark.ss01.1 by presentationformforverticalquestionmark.ss03;
} ss03;

feature ss04 { # Stylistic Set 4
    featureNames {
        name "ss04"; # English - United States
        name 3 1 0x0804 "縱排標點在當字與下字右側之間"; # Chinese - People's Republic of China
    };
    sub presentationformforverticalideographicfullstop by presentationformforverticalideographicfullstop.ss04;
    sub katakanamiddledot.vert by katakanamiddledot.vert.3;
    sub presentationformforverticalideographiccomma by presentationformforverticalideographiccomma.ss04;
    sub presentationformforverticalcomma by presentationformforverticalcomma.ss04;
    sub presentationformforverticalcolon by presentationformforverticalcolon.ss04;
    sub presentationformforverticalsemicolon by presentationformforverticalsemicolon.ss04;
    sub presentationformforverticalexclamationmark by presentationformforverticalexclamationmark.ss04;
    sub presentationformforverticalquestionmark by presentationformforverticalquestionmark.ss04;
    sub halfwidthideographicfullstop.vert by presentationformforverticalideographicfullstop.ss04;
    sub katakanamiddledot.ss01.1 by katakanamiddledot.vert.3;
    sub halfwidthideographiccomma.vert by presentationformforverticalideographiccomma.ss04;
    sub fullwidthcomma.ss01.1 by presentationformforverticalcomma.ss04;
    sub fullwidthcolon.ss01.1 by presentationformforverticalcolon.ss04;
    sub fullwidthsemicolon.ss01.1 by presentationformforverticalsemicolon.ss04;
    sub fullwidthexclamationmark.ss01.1 by presentationformforverticalexclamationmark.ss04;
    sub fullwidthquestionmark.ss01.1 by presentationformforverticalquestionmark.ss04;
} ss04;

feature kern { # Kerning
    script DFLT; # Default
        lookup latn_kern;

    script latn; # Latin
        lookup latn_kern;
} kern;

